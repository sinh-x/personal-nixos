+#[test]
+fn zoom_utility_identity_property_update_order() {
+    let (mut f, _comp, win, _surface, id) = zoom_utility_toplevel("zoom", "Zoom Workplace", false);
+    let assert_id = |f: &TestFixture<FakeXConnection>, expected: &str| {
+        assert_eq!(
+            f.testwl
+                .get_surface_data(id)
+                .unwrap()
+                .toplevel()
+                .app_id
+                .as_deref(),
+            Some(expected)
+        );
+    };
+    f.satellite.set_zoom_utility_candidate(win, true);
+    f.run();
+    assert_id(&f, "zoom.utility");
+    f.satellite
+        .set_win_title(win, WmName::NetWmName("Meeting".into()));
+    f.run();
+    assert_id(&f, "zoom");
+    f.satellite
+        .set_win_title(win, WmName::NetWmName("Zoom Workplace".into()));
+    f.run();
+    assert_id(&f, "zoom.utility");
+    // Preserve the pre-existing _NET_WM_NAME priority over WM_NAME.
+    f.satellite
+        .set_win_title(win, WmName::WmName("Other".into()));
+    f.run();
+    assert_id(&f, "zoom.utility");
+    f.satellite.set_win_class(win, "other-app".into());
+    f.run();
+    assert_id(&f, "other-app");
+    f.satellite.set_win_class(win, "zoom".into());
+    f.run();
+    assert_id(&f, "zoom.utility");
+    f.satellite.set_zoom_utility_candidate(win, false);
+    f.run();
+    assert_id(&f, "zoom");
+
+    // Initial group fallback uses the production constructor, not a test predicate.
+    let group = super::WindowAttributes {
+        class: Some("zoom".into()),
+        title: Some(WmName::WmName("Zoom Workplace".into())),
+        ..Default::default()
+    };
+    let mut attrs = super::WindowAttributes {
+        class: Some("zoom".into()),
+        zoom_utility_candidate: true,
+        ..Default::default()
+    };
+    assert_eq!(
+        attrs.toplevel_identity(Some(&group)).app_id(),
+        Some("zoom.utility")
+    );
+    attrs.class = None;
+    assert_eq!(attrs.toplevel_identity(Some(&group)).app_id(), Some("zoom"));
+}
+
+#[test]
+fn zoom_utility_identity_remap_consistency() {
+    let (mut f, comp, win, mut surface, mut id) =
+        zoom_utility_toplevel("zoom", "Zoom Workplace", true);
+    for _ in 0..3 {
+        assert_eq!(
+            f.testwl
+                .get_surface_data(id)
+                .unwrap()
+                .toplevel()
+                .app_id
+                .as_deref(),
+            Some("zoom.utility")
+        );
+        f.satellite.unmap_window(win);
+        surface.obj.destroy();
+        f.run();
+        assert!(f.testwl.get_surface_data(id).is_none());
+        let (buffer, new_surface) = comp.create_surface();
+        f.satellite.set_zoom_utility_candidate(win, true);
+        f.map_window(&comp, win, &new_surface.obj, &buffer);
+        f.run();
+        id = f.check_new_surface();
+        surface = new_surface;
+    }
+    assert_eq!(
+        f.testwl
+            .get_surface_data(id)
+            .unwrap()
+            .toplevel()
+            .app_id
+            .as_deref(),
+        Some("zoom.utility")
+    );
+}
