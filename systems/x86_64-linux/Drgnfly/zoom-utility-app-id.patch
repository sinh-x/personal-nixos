+// In-process Wayland/X-connection fixture: no real display or user session.
+fn zoom_utility_toplevel(
+    class: &str,
+    title: &str,
+    candidate: bool,
+) -> (
+    TestFixture<FakeXConnection>,
+    Compositor,
+    Window,
+    TestObject<WlSurface>,
+    testwl::SurfaceId,
+) {
+    let (mut f, comp) = TestFixture::new_with_compositor();
+    let win = Window::new(1);
+    f.new_window(
+        win,
+        false,
+        WindowData {
+            mapped: true,
+            dims: WindowDims {
+                width: 50,
+                height: 50,
+                ..Default::default()
+            },
+            ..Default::default()
+        },
+    );
+    f.satellite.set_zoom_utility_candidate(win, candidate);
+    f.satellite.set_win_class(win, class.into());
+    f.satellite.set_win_title(win, WmName::WmName(title.into()));
+    let (buffer, surface) = comp.create_surface();
+    f.map_window(&comp, win, &surface.obj, &buffer);
+    f.run();
+    let id = f.check_new_surface();
+    (f, comp, win, surface, id)
+}
+
+#[test]
+fn zoom_utility_identity_normal_main() {
+    let (mut f, _comp, win, _surface, id) = zoom_utility_toplevel("zoom", "Zoom Workplace", false);
+    assert_eq!(
+        f.testwl
+            .get_surface_data(id)
+            .unwrap()
+            .toplevel()
+            .app_id
+            .as_deref(),
+        Some("zoom")
+    );
+    f.satellite
+        .set_win_title(win, WmName::NetWmName("Meeting".into()));
+    f.run();
+    assert_eq!(
+        f.testwl
+            .get_surface_data(id)
+            .unwrap()
+            .toplevel()
+            .app_id
+            .as_deref(),
+        Some("zoom")
+    );
+}
