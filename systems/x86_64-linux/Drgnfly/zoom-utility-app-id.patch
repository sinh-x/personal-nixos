+// Cache the properties actually forwarded to Wayland. Group fallbacks are
+// resolved at creation, just as before; do not change ordinary title semantics.
+#[derive(Debug)]
+struct ToplevelIdentity {
+    class: Option<String>,
+    title: Option<String>,
+    zoom_utility_candidate: bool,
+}
+
+impl ToplevelIdentity {
+    fn app_id(&self) -> Option<&str> {
+        if self.zoom_utility_candidate
+            && self.class.as_deref() == Some("zoom")
+            && self.title.as_deref() == Some("Zoom Workplace")
+        {
+            Some("zoom.utility")
+        } else {
+            self.class.as_deref()
+        }
+    }
+}
