+#[test]
+fn zoom_utility_identity_other_class() {
+    let atoms = WindowTypes::new();
+    for class in [None, Some(""), Some("Zoom"), Some("other-app")] {
+        assert!(!atoms.zoom_utility_candidate(class, &[atoms.utility], Some(x::Window::new(1))));
+    }
+    for bytes in [
+        b"zoom".as_slice(),
+        b"zoom\0".as_slice(),
+        b"zoom\0\0".as_slice(),
+        b"zoom\0Zoom\0".as_slice(),
+    ] {
+        assert!(!atoms.zoom_utility_candidate(
+            raw_window_class(bytes),
+            &[atoms.utility],
+            Some(x::Window::new(1))
+        ));
+    }
+    assert!(atoms.zoom_utility_candidate(
+        raw_window_class(b"zoom\0zoom\0"),
+        &[atoms.utility],
+        Some(x::Window::new(1))
+    ));
+}
+
+#[test]
+fn zoom_utility_identity_missing_type() {
+    let atoms = WindowTypes::new();
+    for types in [vec![], vec![Atom::new(0xffff)]] {
+        assert!(!atoms.zoom_utility_candidate(Some("zoom"), &types, Some(x::Window::new(1))));
+    }
+    for parent in [None, Some(x::Window::new(0))] {
+        assert!(!atoms.zoom_utility_candidate(Some("zoom"), &[atoms.utility], parent));
+    }
+}
