+// Eligibility needs the actual class field, never the ordinary instance fallback.
+fn raw_window_class(value: &[u8]) -> Option<&str> {
+    std::str::from_utf8(value.split(|b| *b == 0).nth(1)?).ok()
+}
+
+impl WindowTypes {
+    fn zoom_utility_candidate(
+        &self,
+        class: Option<&str>,
+        types: &[x::Atom],
+        transient: Option<x::Window>,
+    ) -> bool {
+        let recognized = [
+            self.normal,
+            self.dialog,
+            self.drag_n_drop,
+            self.splash,
+            self.menu,
+            self.popup_menu,
+            self.dropdown_menu,
+            self.utility,
+            self.tooltip,
+            self.combo,
+        ];
+        class == Some("zoom")
+            && transient.is_some_and(|parent| parent.resource_id() != 0)
+            && types.iter().copied().find(|ty| recognized.contains(ty)) == Some(self.utility)
+    }
+}
